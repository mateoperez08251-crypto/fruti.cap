# FRUTINOVELAS Studio — variables de entorno (sin secretos).
# Copia este archivo a .env y ajusta lo necesario. .env nunca se sube a Git.

# Directorio de datos persistente (vacío = carpeta de usuario según platformdirs).
FRUTINOVELAS_DATA_DIR=

# ── API / interfaz web ───────────────────────────────────
FRUTINOVELAS_API_HOST=127.0.0.1
FRUTINOVELAS_API_PORT=8765
FRUTINOVELAS_API_URL=http://127.0.0.1:8765
# Obligatorio si la API se expone fuera de loopback.
FRUTINOVELAS_API_TOKEN=
# Ejecutar el coordinador de la cola dentro del proceso de la API (true/false).
FRUTINOVELAS_EMBEDDED_WORKER=true

# ── MCP ──────────────────────────────────────────────────
FRUTINOVELAS_MCP_HOST=127.0.0.1
FRUTINOVELAS_MCP_PORT=8766
# Token que exigirá el endpoint Streamable HTTP a clientes remotos.
FRUTINOVELAS_MCP_TOKEN=
# Token con el que el adaptador MCP se identifica ante el backend.
FRUTINOVELAS_MCP_BACKEND_TOKEN=
# Limita el MCP a un proyecto (UUID). Vacío = todos.
FRUTINOVELAS_MCP_PROJECT_ID=
# read_only | read_write
FRUTINOVELAS_MCP_ACCESS_MODE=read_write
FRUTINOVELAS_MCP_PREVIEW_MAX_EDGE=1280
FRUTINOVELAS_MCP_MAX_PAGE_SIZE=100
FRUTINOVELAS_MCP_MAX_FRAMES=5

# ── ComfyUI (también configurable desde la interfaz) ─────
COMFYUI_BASE_URL=http://127.0.0.1:8188

# ── FFmpeg ───────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
