# ── Entornos y dependencias ──────────────────────────────
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
node_modules/
frontend/dist/
frontend/.vite/

# ── Secretos y configuración local ───────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
secrets/
claude_desktop_config.local.json

# ── Bases de datos y datos de usuario ────────────────────
*.sqlite
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.db
data/
frutinovelas-data/
backups/
exports/

# ── Medios pesados y datos de capítulos ──────────────────
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.wav
*.flac
*.mp3
*.m4a
*.aac
*.zip
chapters/
capitulos/

# ── Modelos (nunca en el repositorio) ────────────────────
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.gguf
*.onnx
models/
!src/frutinovelas/models/

# ── Flujos API descargados de cada sesión de Colab ──────
workflows/api/

# ── Markdown privado (guiones, continuidad, notas) ───────
# Solo se versionan README.md y la documentación de docs/.
*.md
!/README.md
!/docs/
!/docs/**/*.md

# ── Fixtures pequeños permitidos explícitamente ──────────
!tests/fixtures/**

# ── Pruebas, cobertura y herramientas ────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/

# ── Logs y temporales ────────────────────────────────────
*.log
logs/
tmp/
*.tmp
*.partial

# ── Editores y sistema ───────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Imágenes y pruebas locales: no se suben al repositorio ---
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.tif
*.tiff
*.heic
*.avif
# Excepción: recursos de la interfaz que la app necesita
!frontend/public/**
# Directorio temporal de pytest en este equipo
.pytest_tmp/
